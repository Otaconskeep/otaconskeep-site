# OtaconsKeep Classroom automation — EXAMPLE ONLY. Copy to /etc/otaconskeep-classroom.env
# chmod 0640; chown classroom:classroom (or the dedicated service account).
# NEVER commit the real file.

# Repository that publishes the site (Cloudflare Workers deploy on push to main)
CLASSROOM_SITE_REPO=/root/otaconskeep-site
CLASSROOM_PACK_REL=classroom/pack

# Optional upstream curriculum mirror (updated by site build sync_github)
CLASSROOM_UPSTREAM_REPO=/root/Classroom

# Runtime (outside git)
CLASSROOM_STATE_DIR=/var/lib/otaconskeep-classroom/state
CLASSROOM_LOG_DIR=/var/log/otaconskeep-classroom
CLASSROOM_STAGING_DIR=/var/lib/otaconskeep-classroom/staging
CLASSROOM_ARTIFACT_DIR=/var/lib/otaconskeep-classroom/artifacts
CLASSROOM_LOCK_FILE=/var/lib/otaconskeep-classroom/classroom.publish.lock

# Model routing via OmniRoute (OpenAI-compatible). Prefer explicit high-quality routes.
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_API_KEY=replace-me
# Writer must meet lesson quality. Do not set a weak local model here unless you accept fail-closed.
WRITER_MODEL=codex/gpt-5.6-sol-medium
CRITIC_MODEL=gc/grok-4.6
# Comma-separated prefixes considered too weak for unsupervised publish
WEAK_MODEL_PREFIXES=ollama-local/,ollama/,llama3.2,granite3
ALLOW_WEAK_MODELS=0
GENERATOR_BACKEND=llm
# curated = explicit dry-run/offline corpus (not a silent downgrade)
# GENERATOR_BACKEND=curated

# Publication (disabled until activation approval)
PUBLISH_MODE=pr
# pr = branch + PR + wait for checks + merge when green
# direct_main = BLOCKED unless ALLOW_DIRECT_MAIN=1 and operator approval recorded
ALLOW_DIRECT_MAIN=0
GIT_REMOTE=origin
GIT_BASE_BRANCH=main
DRY_RUN=1

# News
NEWS_ENABLED=1
NEWS_MAX_BONUS_PER_DAY=1

# Notifications — prefer OtaconsKeep notifier path; optional Discord webhook (never commit)
NOTIFY_BACKEND=otaconskeep
# NOTIFY_BACKEND=discord
# DISCORD_WEBHOOK_URL=
OTACONSKEEP_NOTIFY_SCRIPT=/opt/otaconskeep_notifications/media_announcement.py

# Retention
ARTIFACT_RETENTION_DAYS=45
STAGING_RETENTION_DAYS=14
LOG_RETENTION_DAYS=60

# Timeouts
JOB_TIMEOUT_SEC=7200
LLM_TIMEOUT_SEC=300
LLM_MAX_REPAIR_ATTEMPTS=2
CRITIC_MIN_SCORE=85

# Canonical curriculum+site publish repo (Classroom is one-way mirror target)
CANONICAL_REPO=otaconskeep-site
CLASSROOM_MIRROR_REPO=/root/Classroom

# Dedicated venv (created by install.sh; systemd ExecStart uses this Python)
CLASSROOM_VENV=/var/lib/otaconskeep-classroom/venv
