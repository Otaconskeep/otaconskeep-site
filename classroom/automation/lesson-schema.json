{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://otaconskeep.github.io/classroom/automation/lesson-schema.json",
  "title": "HomelabAcademyLessonBundle",
  "description": "Machine representation of one core or bonus class before render into pack markdown + module activities.",
  "type": "object",
  "required": [
    "schema_version",
    "class_id",
    "title",
    "track",
    "difficulty",
    "estimated_minutes",
    "lab_risk",
    "purpose",
    "prerequisites",
    "learning_objectives",
    "required_reading",
    "terminology",
    "teaching",
    "lab",
    "expected_results",
    "verification",
    "troubleshooting",
    "security",
    "rollback",
    "feynman",
    "homework",
    "quiz",
    "answer_key",
    "video_narration",
    "references",
    "last_reviewed",
    "compatibility"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "class_id": {
      "oneOf": [
        { "type": "integer", "minimum": 16, "maximum": 123 },
        { "type": "string", "pattern": "^NEWS-[0-9]{8}-[a-z0-9-]+$" }
      ]
    },
    "title": { "type": "string", "minLength": 8 },
    "track": { "type": "string", "minLength": 2 },
    "difficulty": { "type": "string", "enum": ["beginner", "intermediate", "advanced"] },
    "estimated_minutes": { "type": "integer", "minimum": 30, "maximum": 240 },
    "lab_risk": { "type": "string", "enum": ["low", "medium", "high"] },
    "purpose": { "type": "string", "minLength": 40 },
    "prerequisites": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } },
    "learning_objectives": { "type": "array", "minItems": 3, "items": { "type": "string", "minLength": 12 } },
    "required_reading": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 8 } },
    "terminology": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["term", "meaning"],
        "properties": {
          "term": { "type": "string" },
          "meaning": { "type": "string", "minLength": 12 }
        }
      }
    },
    "teaching": { "type": "string", "minLength": 800 },
    "architecture": { "type": "string" },
    "lab": { "type": "string", "minLength": 400 },
    "expected_results": { "type": "array", "minItems": 2, "items": { "type": "string" } },
    "verification": { "type": "array", "minItems": 3, "items": { "type": "string" } },
    "troubleshooting": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["symptom", "likely_cause", "fix"],
        "properties": {
          "symptom": { "type": "string" },
          "likely_cause": { "type": "string" },
          "fix": { "type": "string" }
        }
      }
    },
    "security": { "type": "string", "minLength": 80 },
    "rollback": { "type": "string", "minLength": 80 },
    "feynman": { "type": "string", "minLength": 120 },
    "homework": { "type": "string", "minLength": 120 },
    "quiz": { "type": "array", "minItems": 5, "items": { "type": "string", "minLength": 8 } },
    "answer_key": { "type": "array", "minItems": 5, "items": { "type": "string", "minLength": 4 } },
    "video_narration": { "type": "string", "minLength": 80 },
    "references": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 8 } },
    "last_reviewed": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "compatibility": { "type": "string", "minLength": 20 },
    "dangerous_commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["command", "warning", "verification", "rollback"],
        "properties": {
          "command": { "type": "string" },
          "warning": { "type": "string" },
          "prerequisites": { "type": "string" },
          "verification": { "type": "string" },
          "backup": { "type": "string" },
          "rollback": { "type": "string" },
          "failure_mode": { "type": "string" }
        }
      }
    }
  }
}
