# Default: drop into Auto REPL (this is the point of otaconskeep)
if [[ "$NO_REPL" == "1" ]]; then
  printf '  %sTip%s: re-run without OTACONSKEEP_NO_REPL to enter KeepRoute Auto.\n\n' "$D" "$N"
  exit 0
fi

if [[ "$MISS_UP" != "1" ]] && ! curl -fsS --connect-timeout 1 --max-time 2 -o /dev/null "${MC_URL}/v1/missions" 2>/dev/null; then
  if http_ok "$OTACON_URL" || http_ok "http://${LOOP}:${CHAT_PORT}/" || http_ok "http://${LOOP}:11434/api/tags"; then
    printf '  %sMission Controller not detected%s — using Otacon Core / Ollama (%s).
' "$D" "$N" "$LOCAL_MODEL_BARE"
    printf '  Full KeepRoute Auto (Claude/Codex/Cursor/Grok) appears when Missions (:20130) is up.

'
  else
    printf '  %sNo local helper reachable%s — start Otacon (port %s) or Ollama, then re-run.
' "$R" "$N" "$CHAT_PORT"
    printf '  Or open the web UI: %sotaconskeep web%s

' "$Y" "$N"
    exit 1
  fi
fi

keeproute_repl
