}

# Resolve the LOCAL model this machine actually has.
# Core install ships VRAM-tiered qwen2.5:* — never assume this lab's gpt-oss:20b.
resolve_local_model() {
  local bare="" envm="" line
  for envm in "${OTACON_LLM_MODEL:-}" "${ARIA_LOCAL_MODEL:-}" "${OLLAMA_DEFAULT:-}"; do
    [[ -n "$envm" ]] || continue
    bare="${envm#ollama-local/}"
    bare="${bare#ollama/}"
    printf '%s' "$bare"
    return 0
  done
  if command -v systemctl >/dev/null 2>&1; then
    line="$(systemctl show -p Environment otacon.service 2>/dev/null | tr ' ' '\n' | grep '^OTACON_LLM_MODEL=' | head -1 || true)"
    if [[ -n "$line" ]]; then
      bare="${line#OTACON_LLM_MODEL=}"
      bare="${bare#ollama-local/}"
      printf '%s' "$bare"
      return 0
    fi
  fi
  if command -v curl >/dev/null 2>&1; then
    local tags
    tags="$(curl -fsS --connect-timeout 1 --max-time 2 http://127.0.0.1:11434/api/tags 2>/dev/null || true)"
    if [[ -n "$tags" ]]; then
      bare="$(LOCAL_TAGS="$tags" python3 <<'PY'
import json, os
names = []
try:
    names = [m.get("name", "") for m in json.loads(os.environ.get("LOCAL_TAGS", "{}")).get("models", [])]
except Exception:
    names = []
prefer_prefixes = (
    "qwen2.5:14b", "qwen2.5:7b", "qwen2.5:3b", "qwen2.5:1.5b",
    "llama3.2:3b", "llama3.2:1b", "llama3.1:8b",
)
for p in prefer_prefixes:
    for n in names:
        if n == p or n.startswith(p):
            print(n)
            raise SystemExit
for n in names:
    if n.startswith("qwen2.5:"):
        print(n)
        raise SystemExit
for n in names:
    if "gpt-oss" not in n:
        print(n)
        raise SystemExit
if names:
    print(names[0])
PY
)"
      if [[ -n "$bare" ]]; then
        printf '%s' "$bare"
        return 0
      fi
    fi
  fi
  # Last resort: Core's smallest published default (NOT lab gpt-oss)
  printf '%s' "qwen2.5:1.5b"
}

