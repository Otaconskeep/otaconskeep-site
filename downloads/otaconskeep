run_keeproute_auto() {
  local objective="$1"
  [[ -n "$objective" ]] || return 0

  # 1) Mission Controller Auto when present (may route paid CLIs)
  if curl -fsS --connect-timeout 1 --max-time 2 -o /dev/null "${MC_URL}/v1/missions" 2>/dev/null; then
    local out rc
    set +e
    out="$(python3 - "$MC_URL" "$objective" "$LOCAL_MODEL_BARE" <<'PY'
import json, sys, urllib.error, urllib.request
mc, objective, local_bare = sys.argv[1].rstrip("/"), sys.argv[2], sys.argv[3]
payload = json.dumps({
    "objective": objective,
    "archive_evidence": False,
    "allow_paid": True,
}).encode()
req = urllib.request.Request(
    f"{mc}/v1/missions/execute",
    data=payload,
    method="POST",
    headers={"Content-Type": "application/json"},
)
try:
    with urllib.request.urlopen(req, timeout=300) as resp:
        data = json.loads(resp.read().decode("utf-8", errors="replace"))
except urllib.error.HTTPError as e:
    raw = e.read().decode("utf-8", errors="replace")
    try:
        data = json.loads(raw)
    except Exception:
        data = {"ok": False, "error": raw or str(e)}
except Exception as e:
    data = {"ok": False, "error": str(e)}

dec = data.get("decision") or {}
route = dec.get("selected_route") or {}
provider = data.get("actual_provider_reached") or route.get("provider") or "?"
model = str(data.get("actual_model") or route.get("model") or "?")
klass = dec.get("classification") or "?"
paid = data.get("paid_or_local") or "?"
reply = (data.get("reply") or "").rstrip()
err = str(data.get("error") or "")
err_l, model_l = err.lower(), model.lower()

need_fallback = False
if err and any(x in err_l for x in ("not found", "pull", "no such", "unknown model")):
    need_fallback = True
# Lab default gpt-oss leaked onto a box that does not have it
if "gpt-oss" in model_l and local_bare and "gpt-oss" not in local_bare.lower():
    if provider in ("local", "?", "ollama-local") or not reply:
        need_fallback = True
if not reply and err:
    need_fallback = True

if need_fallback:
    print("FALLBACK_LOCAL")
    sys.exit(2)

print(f"  → Auto picked: {provider}  ·  {model}")
print(f"  → class={klass}  ·  {paid}")
if err and not reply:
    print(f"  ✖ {err}")
    sys.exit(1)
if reply:
    print()
    for line in reply.splitlines() or [reply]:
        print(f"  {line}")
    print()
    sys.exit(0 if data.get("ok", True) else 1)
print("  (no reply)")
sys.exit(1)
PY
)"
    rc=$?
    set -e
    if [[ $rc -eq 2 ]] || [[ "$out" == FALLBACK_LOCAL* ]]; then
      printf '  %sAuto local weight not on this Keep — using your install model (%s)%s\n' "$D" "$LOCAL_MODEL_BARE" "$N"
      if http_ok "$OTACON_URL" || http_ok "http://${LOOP}:${CHAT_PORT}/"; then
