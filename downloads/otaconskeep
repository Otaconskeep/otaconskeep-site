type_line() {
  local s="$1" delay="${2:-0.013}"
  if [[ "$NO_ANIM" == "1" ]]; then
    printf '%s\n' "$s"
    return
  fi
  local i
  for ((i = 0; i < ${#s}; i++)); do
    printf '%s' "${s:i:1}"
    sleep "$delay"
  done
  printf '\n'
}

spin_hack() {
  local msg="$1" steps="${2:-18}"
  if [[ "$NO_ANIM" == "1" ]]; then
    printf '  ✓  %s\n' "$msg"
    return
  fi
  local frames=('⣾' '⣽' '⣻' '⢿' '⡿' '⣟' '⣯' '⣷') i=0 n=0
  while (( n < steps )); do
    printf '\r  %s%s%s  %s%s' "$G" "${frames[i++ % 8]}" "$N" "$D" "$msg"
    sleep 0.07
    ((n++)) || true
  done
  printf '\r  %s%s✓%s  %s%s%s\n' "$G" "$B" "$N" "$W" "$msg" "$N"
}

detect_lan_ip() {
  local ip=""
  if command -v ip >/dev/null 2>&1; then
    ip="$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="src"){print $(i+1); exit}}' || true)"
  fi
  if [[ -z "$ip" ]] && command -v hostname >/dev/null 2>&1; then
    ip="$(hostname -I 2>/dev/null | awk '{print $1}' || true)"
  fi
  if [[ -z "$ip" ]]; then
    ip="$(python3 - <<'PY' 2>/dev/null || true
import socket
s=socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
try:
    s.connect(("1.1.1.1", 80))
    print(s.getsockname()[0])
except Exception:
    pass
finally:
    s.close()
PY
)"
  fi
  printf '%s' "${ip:-}"
}

http_ok() {
  local url="$1"
  command -v curl >/dev/null 2>&1 || return 1
  curl -fsS --connect-timeout 1 --max-time 2 -o /dev/null "$url" 2>/dev/null
}

LAN_IP="$(detect_lan_ip)"
LOOP="127.0.0.1"

pick_host_port() {
  local port="$1" path="${2:-/}"
  local h
  # Prefer loopback: Keep services bind 127.0.0.1. Only advertise LAN when it actually answers.
  for h in "$LOOP" ${LAN_IP:+"$LAN_IP"}; do
    [[ -n "$h" ]] || continue
    if http_ok "http://${h}:${port}${path}"; then
      printf '%s' "$h"
      return 0
    fi
  done
  # Offline display: never invent a LAN URL for a loopback-only service.
  printf '%s' "$LOOP"
}

# OmniRoute host port: KeepRoute compose publishes 20127→20128; older installs used 20128 on the host.
# Honor OMNIROUTE_HOST when set (full URL or host[:port]).
resolve_omni_url() {
  local raw="${OMNIROUTE_HOST:-}" host port path h p
  if [[ -n "$raw" ]]; then
    raw="${raw%/}"
    case "$raw" in
      http://*|https://*) printf '%s' "$raw"; return 0 ;;
      *:*) printf 'http://%s' "$raw"; return 0 ;;
      *) printf 'http://%s:20127' "$raw"; return 0 ;;
    esac
  fi
  for p in 20127 20128; do
    for path in "/" "/dashboard"; do
      for h in "$LOOP" ${LAN_IP:+"$LAN_IP"}; do
        [[ -n "$h" ]] || continue
        if http_ok "http://${h}:${p}${path}"; then
          printf 'http://%s:%s' "$h" "$p"
          return 0
        fi
      done
    done
  done
  # Display default matches KeepRoute docker-compose.omniroute.yml host mapping
  printf 'http://%s:20127' "$LOOP"
}

