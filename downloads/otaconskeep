      fi
      ollama_chat "$objective"; return $?
    fi
    printf '%s\n' "$out"
    return "$rc"
  fi

  # 2) Typical Otacon Core user — no Missions stack
  printf '  %sKeep Auto (local)%s — model %s%s%s\n' "$C$B" "$N" "$Y" "$LOCAL_MODEL_BARE" "$N"
  if http_ok "$OTACON_URL" || http_ok "http://${LOOP}:${CHAT_PORT}/"; then
    if otacon_chat "$objective"; then return 0; fi
  fi
  ollama_chat "$objective"
}

keeproute_repl() {
  printf '  %sKeep Auto%s is live — type a mission.\n' "$C$B" "$N"
  if curl -fsS --connect-timeout 1 --max-time 2 -o /dev/null "${MC_URL}/v1/missions" 2>/dev/null; then
    printf '  %sStack%s: KeepRoute Auto (Claude / Codex / Cursor / Grok / Local)\n' "$D" "$N"
    printf '  %sLocal fallback model%s: %s\n' "$D" "$N" "$LOCAL_MODEL_BARE"
  else
    printf '  %sStack%s: Otacon Core / Ollama  ·  model %s\n' "$D" "$N" "$LOCAL_MODEL_BARE"
  fi
  printf '  %sCommands%s:  exit | quit | web | urls | doctor | model\n\n' "$D" "$N"
  local line
  while true; do
    if ! read -r -e -p $'  \033[38;5;46m\033[1mkeep>\033[0m ' line; then
      printf '\n'
      break
    fi
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [[ -z "$line" ]] && continue
    case "$line" in
      exit|quit|q|:q)
        printf '  %slink closed%s\n' "$D" "$N"
        break
        ;;
      web)
        printf '  KeepRoute UI → %s\n' "$KEEP_URL"
        printf '  Otacon Core  → %s\n' "$OTACON_URL"
        if command -v xdg-open >/dev/null 2>&1; then
          xdg-open "$KEEP_URL" >/dev/null 2>&1 || xdg-open "$OTACON_URL" >/dev/null 2>&1 || true
        fi
        continue
        ;;
      urls)
        printf '  %s\n  %s\n  %s\n  %s\n' "$OTACON_URL" "$OMNI_URL" "$KEEP_URL" "$MISS_URL"
        continue
        ;;
      model)
        printf '  Local model for this Keep: %s\n' "$LOCAL_MODEL_BARE"
        continue
        ;;
      doctor)
        if command -v otacon >/dev/null 2>&1; then otacon doctor || true
        elif [[ -x "${HOME}/.local/bin/otacon" ]]; then "${HOME}/.local/bin/otacon" doctor || true
        else printf '  otacon doctor not installed\n'; fi
        continue
        ;;
    esac
    printf '\n'
    set +e
    run_keeproute_auto "$line"
    set -e
    printf '\n'
  done
}

