#!/bin/bash
name=$(git config user.name)
email=$(git config user.email)
if [ -z "$name" ] || [ -z "$email" ]; then
  echo "ERROR: git user.name/email not set. Use Antonio G. Garcia <230031249+Otaconskeep@users.noreply.github.com>" >&2
  exit 1
fi
case "$email" in
  root@pve.local|root@*|*\.local)
    echo "ERROR: refusing commit with non-GitHub author email: $email" >&2
    echo "Set: git config user.email '230031249+Otaconskeep@users.noreply.github.com'" >&2
    exit 1
    ;;
esac
if [ "$name" = "root" ] || [ "$name" = "Cursor" ] || [ "$name" = "Claude" ] || [ "$name" = "Codex" ]; then
  echo "ERROR: refusing commit with tooling/root author name: $name" >&2
  exit 1
fi
